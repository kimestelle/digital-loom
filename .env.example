# fal.ai credential for the Patina material extraction.
# Locally: copy this file to .env and paste your key (never committed —
# .gitignore covers .env*).
# On Vercel: add FAL_KEY as an Environment Variable in the project
# settings; users can also paste their own key in the material import panel, which
# overrides this per request.
FAL_KEY=

# Older deployments using FAL_API_KEY continue to work as a fallback, but
# new local and hosted environments should use FAL_KEY.
# FAL_API_KEY=

# Optional overrides (defaults are sensible everywhere):
# LOOM_CACHE_DIR=     where extractions are cached (default: ./cache locally, /tmp/loom-cache on Vercel)
# LOOM_PRESETS_DIR=   where user presets are written (default: ./cache/presets locally, /tmp/loom-presets on Vercel)
# PATINA_ENDPOINT_ID= alternate fal endpoint id
